# Copia questo file in ".env" e incolla la tua chiave (quando la creeremo).
# Senza chiave, il backend funziona comunque in modalità DEMO.

# Chiave gratuita di Google Gemini (da Google AI Studio)
GEMINI_API_KEY=

# Modello da usare (lasciare così va bene per iniziare)
GEMINI_MODEL=gemini-2.0-flash
